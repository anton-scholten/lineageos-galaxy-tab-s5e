<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared repos for every Galaxy Tab S5e variant (LineageOS 23.2).
  Copy this file to .repo/local_manifests/ along with gts4lvwifi.xml (Wi-Fi)
  and/or gts4lv.xml (LTE), then run `repo sync`.

  device/samsung/gts4lv-common and kernel/samsung/sdm670 come from the
  anton-scholten forks, branch lineage-23.2: the device tree with patches 0001-0004
  plus the audio XML commit and the P6 AntHalService fix (d154fb4384fb), and the kernel with the ported eBPF
  series and the SELinux avtab fix (500658be3c16), which boots.
  Build with: source build/envsetup.sh && brunch gts4lvwifi
  The other repos have no lineage-23.2 branch and stay on lineage-22.2.
-->
<manifest>
  <remote name="muppets" fetch="https://github.com/TheMuppets" />
  <remote name="anton" fetch="https://github.com/anton-scholten" />

  <project path="device/samsung/gts4lv-common"
           name="android_device_samsung_gts4lv-common"
           remote="anton" revision="lineage-23.2" />

  <!-- Kernel shared by all variants (needs the backports in KERNEL-BACKPORT-PLAN.md) -->
  <project path="kernel/samsung/sdm670"
           name="android_kernel_samsung_sdm670"
           remote="anton" revision="lineage-23.2" />

  <!-- hardware/samsung has a real lineage-23.2 branch -->
  <project path="hardware/samsung"
           name="LineageOS/android_hardware_samsung"
           remote="github" revision="lineage-23.2" />

  <project path="vendor/samsung/gts4lv-common"
           name="proprietary_vendor_samsung_gts4lv-common"
           remote="anton" revision="lineage-23.2" />
</manifest>
