From 647daf445a93356067386c96da524338cf6dc78c Mon Sep 17 00:00:00 2001
From: ahscholt <124476596+anton-scholten@users.noreply.github.com>
Date: Mon, 12 Oct 2026 18:50:38 -0400
Subject: [PATCH] Health: ship only the Lineage AIDL HAL, drop the Samsung blob

android.hardware.health-service.samsung and vendor.lineage.health-service.default
were both in PRODUCT_PACKAGES. On a booted 23.2 tablet both processes ran
(PIDs 1098 and 1119), but only the blob registered IHealth/default -- it is
first in the list and wins the servicemanager race. The Lineage HAL therefore
never owned the service, and the charging-control feature configured via
soong_config_set below was silently dead.

Drops the blob rather than the Lineage HAL: the Lineage HAL provides the
"lineage_health" Soong config module that gts4lv.mk reads for
charging_control_*, fast_charge_node and friends, so removing it would strand
those calls. The blob has no other reference in this tree.

Not build-verified (no build in this task). Needs an on-device check that the
Lineage HAL still populates every battery field the blob did.

Fix-by: Space Bunny Free (owner-directed session 2026-10-12); measured PIDs and
servicemanager registration on release build 23.2-20261008-UNOFFICIAL-gts4lvwifi
---
 gts4lv.mk | 22 +++++++++++++++++-----
 1 file changed, 17 insertions(+), 5 deletions(-)

diff --git a/gts4lv.mk b/gts4lv.mk
index 8accc4a..e69c57d 100644
--- a/gts4lv.mk
+++ b/gts4lv.mk
@@ -156,18 +156,30 @@ PRODUCT_PACKAGES += \
     android.hardware.gatekeeper@1.0-service
 
 # Health
+#
+# Only the Lineage AIDL health HAL is shipped. The Samsung blob
+# (android.hardware.health-service.samsung) used to be installed alongside it and
+# won the IHealth/default registration, because it starts first: on a booted
+# 23.2 tablet both ran (PIDs 1098 and 1119) and only the blob ever appeared in
+# servicemanager's log. That left vendor.lineage.health-service.default unable
+# to register, so the charging-control feature configured below was dead.
+#
+# The blob is referenced nowhere else in this tree (no init rc, no VINTF, no
+# recovery root). Removing it rather than the Lineage HAL, because the Lineage
+# HAL owns the "lineage_health" Soong config module read just below: dropping
+# that package would leave the soong_config_set calls with no consumer, which is
+# a build risk that cannot be checked without a build.
+#
+# TODO reviewer: confirm on device that the Lineage HAL populates everything the
+# blob did. Vendor-only battery properties are the risk, not the basic ones.
 PRODUCT_PACKAGES += \
-    android.hardware.health-service.samsung \
-    android.hardware.health-service.samsung-recovery
+    vendor.lineage.health-service.default
 
 # HotwordEnrollement app permissions
 PRODUCT_COPY_FILES += \
     $(LOCAL_PATH)/configs/privapp-permissions-hotword.xml:system/etc/permissions/privapp-permissions-hotword.xml
 
 # Lineage Health
-PRODUCT_PACKAGES += \
-    vendor.lineage.health-service.default
-
 $(call soong_config_set,lineage_health,charging_control_charging_path,/sys/class/power_supply/battery/batt_slate_mode)
 $(call soong_config_set,lineage_health,charging_control_charging_enabled,0)
 $(call soong_config_set,lineage_health,charging_control_charging_disabled,1)
-- 
2.47.3

