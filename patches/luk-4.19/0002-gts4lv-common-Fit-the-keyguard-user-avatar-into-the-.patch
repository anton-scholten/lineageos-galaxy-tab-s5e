From 9a04c0976f3a52692935e5c1e946fd1f83d2d4be Mon Sep 17 00:00:00 2001
From: Anton Scholten <124476596+anton-scholten@users.noreply.github.com>
Date: Sat, 14 Nov 2026 11:44:57 -0500
Subject: [PATCH 2/3] gts4lv-common: Fit the keyguard user avatar into the
 status bar

The 30dp sw600dp default is taller than the 28dp keyguard status bar,
so the avatar is clipped and touches the screen edge.

Assisted-by: LLM - Claude Opus 5.5
Change-Id: If44dec5876d267ec71d0dd8795af72bb2da5443c
---
 overlay/SystemUIResCommon/res/values-sw600dp/dimens.xml | 9 +++++++++
 1 file changed, 9 insertions(+)
 create mode 100644 overlay/SystemUIResCommon/res/values-sw600dp/dimens.xml

diff --git a/overlay/SystemUIResCommon/res/values-sw600dp/dimens.xml b/overlay/SystemUIResCommon/res/values-sw600dp/dimens.xml
new file mode 100644
index 0000000..67c2b0d
--- /dev/null
+++ b/overlay/SystemUIResCommon/res/values-sw600dp/dimens.xml
@@ -0,0 +1,9 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: The LineageOS Project
+     SPDX-License-Identifier: Apache-2.0
+-->
+<resources>
+    <!-- The keyguard status bar is only 28dp tall here. -->
+    <dimen name="multi_user_avatar_keyguard_size">24dp</dimen>
+</resources>
-- 
